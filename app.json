{
  "expo": {
    "name": "42",
    "slug": "FortyTwo",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "cover",
      "backgroundColor": "#020B18"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.flying-riceball.FortyTwo",
      "infoPlist": {
        "NSCameraUsageDescription": "42 uses your camera to take workout selfies.",
        "NSPhotoLibraryUsageDescription": "42 uses your photos to add workout photos.",
        "NSPhotoLibraryAddUsageDescription": "42 saves workout photos to your photo library."
      }
    },
    "android": {
      "package": "com.fortytwo.challenge",
      "versionCode": 6,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#020B18"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "CAMERA",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "POST_NOTIFICATIONS"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "buildReactNativeFromSource": true
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "42 uses your location to track distance during outdoor workouts.",
          "locationAlwaysAndWhenInUsePermission": "42 uses your location to track distance even when the screen is off.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "42 uses your photos to add workout photos.",
          "cameraPermission": "42 uses your camera to take workout selfies."
        }
      ],
      "expo-sharing",
      [
        "expo-notifications",
        {
          "sounds": []
        }
      ],
      "expo-build-properties"
    ]
  }
}
